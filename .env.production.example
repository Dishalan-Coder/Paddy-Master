# Copy to .env.production and replace every production-sensitive value.
PUBLIC_SITE_URL=https://paddymaster.example.com
FRONTEND_PORT=80

DB_NAME=paddy_master
MONGO_ROOT_USERNAME=paddy_master_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=https://paddymaster.example.com

WEATHER_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
